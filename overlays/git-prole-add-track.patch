diff --git a/config.toml b/config.toml
index 5a5eca9..859988d 100644
--- a/config.toml
+++ b/config.toml
@@ -61,6 +61,12 @@ enable_gh = false
 # See: `man 'gitignore(5)'`
 copy_ignored = true

+# When `git prole add` creates a new branch from the default branch, the new
+# branch is set to track it (`git worktree add --track`). Set this to `false` to
+# start the new branch at the default branch without tracking it (`--no-track`),
+# so it can be pushed to a remote branch of the same name.
+track = true
+
 # Commands to run when a new worktree is added.
 commands = [
     # "direnv allow",
diff --git a/src/add.rs b/src/add.rs
index aff72a5..1d88b83 100644
--- a/src/add.rs
+++ b/src/add.rs
@@ -135,12 +135,15 @@ impl<'a> WorktreePlan<'a> {
                 branch,
                 start,
             } => {
-                let track = matches!(start, StartPoint::Branch(_));
+                let track = match start {
+                    StartPoint::Branch(_) => Some(self.git.config.file.add.track()),
+                    StartPoint::Commitish(_) => None,
+                };

                 (*force, track, Some(branch))
             }
             BranchStartPointPlan::Detach(_) | BranchStartPointPlan::Existing(_) => {
-                (false, false, None)
+                (false, None, None)
             }
         };

